    "Check your connection and try loading the latest photos again." : {
      "comment" : "Generic explanation shown when the main photo feed could not be loaded.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your connection and try loading the latest photos again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión e intenta cargar de nuevo las fotos más recientes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion et réessayez de charger les dernières photos."
